/*
 * The executable icon shown by Explorer, the taskbar and Alt-Tab, and the icon
 * GPUI uses for the window class: its Windows backend loads icon resource ID 1
 * from the executable (gpui-pre-windows `load_icon`). Keep the ID at 1.
 *
 * The path is relative to this file, which is also the resource compiler's
 * working directory: embed-resource runs RC.EXE from the crate root.
 */
0 ICON "../../assets/branding/kytrix_bordered.ico"
1 ICON "../../assets/branding/kytrix.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Kytrix Industries\0"
            VALUE "FileDescription", "Kytrix\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "Kytrix\0"
            VALUE "OriginalFilename", "Kytrix.exe\0"
            VALUE "ProductName", "Kytrix\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END